<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox alignment="TOP_CENTER" prefHeight="620.0" prefWidth="400.0" spacing="0.0"
      style="-fx-background-color: #FFFFFF; -fx-background-radius: 20;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vallegrande.edu.pe.saborcasero.controller.LoginController">

    <!-- Header superior marrón -->
    <VBox alignment="CENTER" prefHeight="150.0" spacing="8.0" style="-fx-background-color: #3D1E16; -fx-background-radius: 20 20 0 0;">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15" />
        </padding>

        <VBox alignment="CENTER" maxHeight="44.0" maxWidth="44.0" prefHeight="44.0" prefWidth="44.0"
              style="-fx-background-color: #E89874; -fx-background-radius: 10;">
            <Label style="-fx-font-size: 20px;" text="🍴" />
        </VBox>

        <Label style="-fx-text-fill: #F5E5C9; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Georgia', serif;" text="Sabor Casero" />
        <Label style="-fx-text-fill: #D3A88C; -fx-font-size: 11px;" text="Sistema de gestión de restaurante" />
    </VBox>

    <!-- Contenido principal -->
    <VBox alignment="CENTER" spacing="15.0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Imagen del restaurante -->
        <ImageView fitHeight="140.0" fitWidth="350.0" preserveRatio="false">
            <image>
                <Image url="@images/restaurant.jpg" />
            </image>
            <clip>
                <Rectangle arcHeight="20.0" arcWidth="20.0" height="140.0" width="350.0" />
            </clip>
        </ImageView>

        <!-- Textos de bienvenida -->
        <VBox alignment="CENTER" spacing="4.0">
            <Label style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" text="Bienvenido de vuelta" />
            <Label style="-fx-text-fill: #777777; -fx-font-size: 11px;" text="Gestiona pedidos, mesas y reservas desde un solo lugar." />
        </VBox>

        <!-- Botones -->
        <VBox alignment="CENTER" maxWidth="280.0" prefWidth="280.0" spacing="10.0">
            <padding>
                <Insets top="10" />
            </padding>

            <Button onAction="#onIniciarSesionClick" prefHeight="38.0" prefWidth="280.0"
                    style="-fx-background-color: #DF5E37; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Iniciar sesion" />

            <Button onAction="#onCrearCuentaClick" prefHeight="38.0" prefWidth="280.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: #CCCCCC; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 13px; -fx-cursor: hand;"
                    text="Crear Cuenta" />
        </VBox>
    </VBox>
</VBox>